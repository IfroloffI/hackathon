{
  "name": "chronolet",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "volta": {
    "node": "22.23.4"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "test": "npm test -w shared && npm test -w server",
    "livekit": "concurrently -k -n livekit,tls -c blue,green \"bash scripts/livekit.sh\" \"node scripts/livekit-tls.mjs\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@livekit/agents": "^1.9.5",
    "livekit-server-sdk": "^2.19.2"
  }
}
